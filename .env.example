# ====================================================================
# Share a Meal — Production SMS OTP Verification Configuration
# Provider: Twilio Verify v2
# ====================================================================

# Supabase browser configuration. These are safe-to-expose publishable values;
# never add a Supabase service-role key to a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Phone.Email public client ID for the Step 1 mobile-verification button.
VITE_PHONE_EMAIL_CLIENT_ID=your-phone-email-client-id

# SMS Provider Selection (default: twilio)
SMS_PROVIDER=twilio

# Your Twilio Account SID (starts with AC...)
# Found in your Twilio Console Dashboard: https://console.twilio.com/
SMS_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your Twilio Auth Token (keep strictly secret, never commit to git)
# Found in your Twilio Console Dashboard: https://console.twilio.com/
SMS_AUTH_TOKEN=your_auth_token_here

# Your Twilio Verify Service SID (starts with VA...)
# Created under Verify > Services in Twilio Console: https://console.twilio.com/us1/develop/verify/services
SMS_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Server-Side HMAC-SHA256 Signing Secret for generating tamper-proof verification tokens
OTP_SECRET=replace-with-a-unique-random-32-plus-character-server-secret

# ====================================================================
# Instructions for Testing with Real SMS:
# 1. Create a free/trial Twilio account at https://www.twilio.com/
# 2. Go to Verify > Services > Create Service (Name: "Share a Meal Verification").
# 3. For trial accounts: Verify recipient phone numbers in Twilio Console under
#    "Verified Caller IDs" if sending to trial test numbers in India (+91).
# 4. Copy SMS_ACCOUNT_SID, SMS_AUTH_TOKEN, and SMS_VERIFY_SERVICE_SID into your local .env file.
# 5. Restart the server (`npm run dev`) to enable live cellular SMS dispatch.
# ====================================================================
